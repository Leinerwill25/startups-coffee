# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large raw media files — HEIC originals (converted to JPG) excluded
public/*.HEIC
public/*.heic

# Exclude all MOVs except those used in the app components
public/*.MOV
public/*.mov
!public/a.mov
!public/b.mov
!public/c.mov
!public/IMG_2003.MOV
!public/IMG_2016.MOV
